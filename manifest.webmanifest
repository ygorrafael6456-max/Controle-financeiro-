{
  "id": "./",
  "name": "Controle Financeiro",
  "short_name": "Financeiro",
  "description": "Seu controle pessoal de receitas, despesas e economias.",
  "start_url": "./index.html?source=installed-app",
  "scope": "./",
  "display": "standalone",
